---
import type { Site } from '../lib/schema';
import { renderMarkdown } from '../lib/markdown';
import { withBase } from '../lib/utils';
import SectionHeading from './SectionHeading.astro';

interface Props {
  site: Site;
}
const { site } = Astro.props;
const aboutHtml = renderMarkdown(site.profile.about);
---

<section id="about" class="section scroll-mt-24" aria-labelledby="about-title">
  <div class="shell">
    <SectionHeading
      index="04"
      eyebrow="about"
      title="Background & experience"
      description="Short version: eight years of shipping, the last few as an independent engineer."
      id="about-title"
    />

    <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-14">
      <div>
        <div class="prose-doc max-w-none" set:html={aboutHtml} />

        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line/70 pt-6 text-sm">
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">based in</dt>
            <dd class="mt-1">{site.profile.location}</dd>
          </div>
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">timezone</dt>
            <dd class="mt-1 font-mono text-[13px]">{site.profile.timezone}</dd>
          </div>
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">status</dt>
            <dd class="mt-1 flex items-center gap-2">
              <span
                class={`h-1.5 w-1.5 rounded-full ${site.profile.availability.available ? 'bg-accent' : 'bg-muted'}`}
                aria-hidden="true"></span>
              {site.profile.availability.label}
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">working with</dt>
            <dd class="mt-1">Teams of 2–40, remote-first</dd>
          </div>
        </dl>

        {
          site.profile.cv && (
            <a href={withBase(site.profile.cv)} download class="btn-ghost mt-8">
              download cv
              <span class="font-mono text-[10px] text-muted">pdf</span>
            </a>
          )
        }
      </div>

      <ol class="relative list-none space-y-0 p-0">
        {
          site.experience.map((job, index) => (
            <li class="relative grid grid-cols-[auto_1fr] gap-4 pb-8 last:pb-0">
              <div class="flex flex-col items-center">
                <span
                  class:list={[
                    'mt-1.5 h-2 w-2 shrink-0 rounded-full',
                    job.current ? 'bg-accent shadow-[0_0_0_4px_rgb(var(--accent-rgb)/0.12)]' : 'bg-line',
                  ]}
                  aria-hidden="true"
                />
                {index < site.experience.length - 1 && <span class="mt-2 w-px flex-1 bg-line/80" aria-hidden="true" />}
              </div>
              <div class="pb-1">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="text-[15px] font-semibold tracking-tight">{job.role}</h3>
                  <span class="font-mono text-[11px] text-muted">{job.period}</span>
                </div>
                <p class="mt-0.5 font-mono text-[11.5px] text-accent/80">{job.company}</p>
                {job.summary && <p class="mt-2 text-[13px] leading-relaxed text-muted">{job.summary}</p>}
                {job.highlights.length > 0 && (
                  <ul class="mt-3 list-none space-y-1.5 p-0">
                    {job.highlights.map((highlight) => (
                      <li class="flex gap-2 text-[12.5px] leading-relaxed text-ink/80">
                        <span class="select-none font-mono text-accent/60" aria-hidden="true">
                          →
                        </span>
                        {highlight}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
