---
import type { Site } from '../lib/schema';
import SectionHeading from './SectionHeading.astro';

interface Props {
  site: Site;
}
const { site } = Astro.props;

const process = [
  {
    step: '01',
    title: 'discover',
    text: 'A short call, then a written scope with assumptions and a fixed price for the first phase.',
  },
  {
    step: '02',
    title: 'build',
    text: 'Weekly increments you can click on, a shared board, and no surprises at the end.',
  },
  { step: '03', title: 'deliver', text: 'Deployed, monitored, documented. Handover includes a recorded walkthrough.' },
  { step: '04', title: 'support', text: 'Two weeks of included aftercare, then an optional retainer if you want one.' },
];
---

<section id="services" class="section scroll-mt-24" aria-labelledby="services-title">
  <div class="shell">
    <SectionHeading
      index="02"
      eyebrow="services"
      title="What I do for clients"
      description="Four ways I usually get hired. Every engagement starts with a written scope, a price and a definition of done."
      id="services-title"
    >
      <a slot="aside" href="#contact" class="btn-link font-mono text-[12px]">start a project →</a>
    </SectionHeading>

    <ul class="grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2">
      {
        site.services.map((service, index) => (
          <li class="group relative overflow-hidden rounded-xl border border-line bg-surface p-6 transition-colors hover:border-accent/30">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-muted">
                  svc / {String(index + 1).padStart(2, '0')}
                </p>
                <h3 class="mt-2 text-lg font-semibold tracking-tight">{service.title}</h3>
              </div>
              <span
                class="font-mono text-2xl text-line transition-colors group-hover:text-accent/40"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            <p class="mt-3 text-[13.5px] leading-relaxed text-muted">{service.description}</p>
            {service.deliverables.length > 0 && (
              <ul class="mt-5 list-none space-y-2 border-t border-line/70 p-0 pt-4">
                {service.deliverables.map((item) => (
                  <li class="flex items-start gap-2 text-[13px] text-ink/85">
                    <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-accent/70" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <div class="mt-10 rounded-xl border border-line bg-elevated/40 p-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h3 class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">how it runs</h3>
        <p class="font-mono text-[11px] text-muted">typical engagement: 3–8 weeks</p>
      </div>
      <ol class="mt-6 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:grid-cols-4">
        {
          process.map((item, index) => (
            <li class="relative">
              <div class="flex items-center gap-2">
                <span class="font-mono text-[11px] text-accent">{item.step}</span>
                <span class="h-px flex-1 bg-line" aria-hidden="true" />
                {index < process.length - 1 && (
                  <span class="hidden font-mono text-[10px] text-muted/50 lg:block" aria-hidden="true">
                    →
                  </span>
                )}
              </div>
              <p class="mt-2 font-mono text-[12.5px] font-medium uppercase tracking-wide text-ink">{item.title}</p>
              <p class="mt-1.5 text-[12.5px] leading-relaxed text-muted">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
