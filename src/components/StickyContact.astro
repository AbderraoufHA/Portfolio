---
import type { Site } from '../lib/schema';
import { withBase } from '../lib/utils';

interface Props {
  site: Site;
}
const { site } = Astro.props;
const email = site.socials.email || site.contact.email;
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-bg/95 backdrop-blur md:hidden"
  style="padding: 0.7rem 1rem calc(0.7rem + env(safe-area-inset-bottom));"
>
  <div class="flex items-center gap-2">
    <a href={`${withBase('/')}#contact`} class="btn-primary flex-1 py-2.5 text-[13px]">
      start a project
      <span aria-hidden="true">↗</span>
    </a>
    <a href={`mailto:${email}`} class="btn-ghost px-3 py-2.5 text-[13px]" aria-label={`Email ${site.profile.name}`}>
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</div>
