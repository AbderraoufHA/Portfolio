---
import type { Site } from '../lib/schema';
import { withBase } from '../lib/utils';
import SectionHeading from './SectionHeading.astro';

interface Props {
  site: Site;
  /** Section number in the heading; pages with fewer sections can renumber. */
  index?: string;
}
const { site, index = '06' } = Astro.props;
const { contact, socials, profile } = site;
const email = socials.email || contact.email;
const provider = contact.provider;
const hasKey = Boolean(contact.key) && provider !== 'mailto';
---

<section id="contact" class="section relative scroll-mt-24 overflow-hidden" aria-labelledby="contact-title">
  <div class="pointer-events-none absolute inset-0 glow-accent opacity-60" aria-hidden="true"></div>
  <div class="shell relative">
    <SectionHeading
      index={index}
      eyebrow="contact"
      title="Start a project"
      description="Tell me what you are building and what is in the way. I answer every serious enquiry myself."
      id="contact-title"
    >
      <span slot="aside" class="font-mono text-[11px] text-muted">
        <span
          class={`mr-1.5 inline-block h-1.5 w-1.5 rounded-full ${profile.availability.available ? 'bg-accent' : 'bg-muted'}`}
          aria-hidden="true"></span>
        {contact.responseTime || 'Replies within 24h'}
      </span>
    </SectionHeading>

    <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="flex flex-col gap-4">
        <div class="rounded-xl border border-line bg-surface p-5">
          <h3 class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-muted">direct</h3>
          <a
            href={`mailto:${email}`}
            class="mt-3 flex items-center gap-2 font-mono text-[13.5px] text-ink transition-colors hover:text-accent"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            {email}
          </a>
          <ul class="mt-4 space-y-2 border-t border-line/70 pt-4">
            {
              socials.telegram && (
                <li>
                  <a
                    href={socials.telegram}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-muted flex items-center gap-2 font-mono text-[12px]"
                  >
                    <span class="text-accent/60" aria-hidden="true">
                      →
                    </span>{' '}
                    telegram
                    <span class="text-[10px] opacity-50" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                </li>
              )
            }
            {
              socials.whatsapp && (
                <li>
                  <a
                    href={socials.whatsapp}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-muted flex items-center gap-2 font-mono text-[12px]"
                  >
                    <span class="text-accent/60" aria-hidden="true">
                      →
                    </span>{' '}
                    whatsapp
                    <span class="text-[10px] opacity-50" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                </li>
              )
            }
            {
              socials.linkedin && (
                <li>
                  <a
                    href={socials.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-muted flex items-center gap-2 font-mono text-[12px]"
                  >
                    <span class="text-accent/60" aria-hidden="true">
                      →
                    </span>{' '}
                    linkedin
                    <span class="text-[10px] opacity-50" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                </li>
              )
            }
            {
              socials.github && (
                <li>
                  <a
                    href={socials.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-muted flex items-center gap-2 font-mono text-[12px]"
                  >
                    <span class="text-accent/60" aria-hidden="true">
                      →
                    </span>{' '}
                    github
                    <span class="text-[10px] opacity-50" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                </li>
              )
            }
          </ul>
        </div>

        {
          contact.bookingUrl && (
            <div class="rounded-xl border border-line bg-surface p-5">
              <h3 class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-muted">or skip the form</h3>
              <p class="mt-2 text-[13px] leading-relaxed text-muted">
                Grab a 20-minute slot. No pitch, just the problem and whether I can help.
              </p>
              <a
                href={contact.bookingUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-ghost mt-4 w-full text-[13px]"
              >
                book an intro call
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          )
        }

        <div
          class="rounded-xl border border-line/70 bg-elevated/40 p-5 font-mono text-[11px] leading-relaxed text-muted"
        >
          <p><span class="text-accent/70">$</span> response_time: {contact.responseTime || 'under 24h'}</p>
          <p><span class="text-accent/70">$</span> timezone: {profile.timezone}</p>
          <p><span class="text-accent/70">$</span> nda: happy to sign one</p>
        </div>
      </div>

      <div class="rounded-xl border border-line bg-surface p-6 sm:p-8">
        {
          hasKey ? (
            <form
              data-contact-form
              data-provider={provider}
              data-key={contact.key}
              data-endpoint={contact.endpoint || ''}
              data-email={email}
              novalidate
              class="space-y-5"
            >
              <div class="grid gap-5 sm:grid-cols-2">
                <div class="field">
                  <label for="contact-name" class="field-label">
                    Your name
                  </label>
                  <input
                    id="contact-name"
                    name="name"
                    type="text"
                    autocomplete="name"
                    required
                    minlength="2"
                    maxlength="80"
                    class="field-input"
                    placeholder="Jane Doe"
                    aria-describedby="contact-name-error"
                  />
                  <p id="contact-name-error" data-error-for="name" hidden class="field-error" role="alert" />
                </div>
                <div class="field">
                  <label for="contact-email" class="field-label">
                    Email
                  </label>
                  <input
                    id="contact-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                    class="field-input"
                    placeholder="jane@company.com"
                    aria-describedby="contact-email-error"
                  />
                  <p id="contact-email-error" data-error-for="email" hidden class="field-error" role="alert" />
                </div>
              </div>

              <div class="field">
                <label for="contact-message" class="field-label">
                  What are you building?
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="6"
                  required
                  minlength="20"
                  maxlength="4000"
                  class="field-input resize-y"
                  placeholder="A sentence about the product, the deadline, and what is currently blocking you."
                  aria-describedby="contact-message-error contact-message-hint"
                />
                <p id="contact-message-hint" class="field-hint">
                  Markdown not needed — plain text is fine.
                </p>
                <p id="contact-message-error" data-error-for="message" hidden class="field-error" role="alert" />
              </div>

              <div class="sr-only" aria-hidden="true">
                <label for="contact-company">Company (leave empty)</label>
                <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <p class="max-w-[22rem] font-mono text-[10.5px] leading-relaxed text-muted">
                  No newsletter, no CRM. Your message goes to my inbox and nowhere else.
                </p>
                <button type="submit" data-contact-submit class="btn-primary shrink-0 px-5 py-3">
                  send message
                  <span aria-hidden="true">↗</span>
                </button>
              </div>
              <p
                data-contact-status
                role="status"
                aria-live="polite"
                class="min-h-[1rem] font-mono text-[11px] text-muted"
              />
            </form>
          ) : (
            <div class="flex h-full flex-col justify-center">
              <p class="eyebrow">form not configured</p>
              <h3 class="mt-2 text-xl font-semibold tracking-tight">The fastest route is email.</h3>
              <p class="mt-3 max-w-md text-[13.5px] leading-relaxed text-muted">
                This site is static, so the form needs a public Web3Forms key (or a Formspree ID) in
                <code class="rounded border border-line bg-elevated px-1.5 py-0.5 font-mono text-[11.5px]">
                  src/content/site.json
                </code>
                . Until then, email works exactly the same.
              </p>
              <a href={`mailto:${email}?subject=Project%20enquiry`} class="btn-primary mt-5 w-fit">
                email me
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          )
        }

        <div
          data-contact-success
          hidden
          tabindex="-1"
          class="flex min-h-[22rem] flex-col items-start justify-center outline-none"
        >
          <span
            class="flex h-10 w-10 items-center justify-center rounded-full border border-accent/30 bg-accent/10 font-mono text-accent"
            aria-hidden="true">✓</span
          >
          <h3 class="mt-4 text-xl font-semibold tracking-tight">Message sent.</h3>
          <p class="mt-2 max-w-sm text-[13.5px] leading-relaxed text-muted">
            Thanks — it landed. I reply within one business day, usually sooner. If it is urgent, email me directly.
          </p>
          <a href={`mailto:${email}`} class="btn-link mt-4 font-mono text-[12px]">{email}</a>
        </div>

        {
          hasKey && (
            <div data-contact-error hidden class="mt-5 rounded-lg border border-red-500/30 bg-red-500/5 p-4">
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-red-300">delivery failed</p>
              <p data-contact-error-detail class="mt-1 text-[13px] text-muted" />
              <a data-contact-mailto href={`mailto:${email}`} class="btn-ghost mt-3 text-[12.5px] border-red-500/30">
                send it as a normal email instead
              </a>
            </div>
          )
        }
      </div>
    </div>

    <p class="mt-10 text-center font-mono text-[10.5px] text-muted/70">
      Prefer async? <a
        class="underline decoration-line underline-offset-4 hover:decoration-accent"
        href={`${withBase('/')}#work`}>read a case study first</a
      > — it answers most of the usual questions.
    </p>
  </div>
</section>
