---
import { createHash } from 'node:crypto';
import '../styles/global.css';
import interFont from '../assets/fonts/inter-var.woff2?url';
import monoFont from '../assets/fonts/jetbrains-mono-var.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import StickyContact from '../components/StickyContact.astro';
import { getPublishedProjects, getSite } from '../lib/content';
import { absoluteUrl, darken, hexToRgbChannels, withBase } from '../lib/utils';
import type { Project } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Absolute site-relative path used to build the canonical URL. Defaults to the current page. */
  canonicalPath?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  chrome?: boolean;
  /** One or more JSON-LD objects rendered as a single @graph. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath,
  image = '/images/og-default.webp',
  type = 'website',
  noindex = false,
  chrome = true,
  jsonLd = [],
} = Astro.props;

const site = getSite();
const projects: Project[] = getPublishedProjects();
const siteName = `${site.profile.name} — ${site.profile.title}`;
const fullTitle = title === siteName ? title : `${title} | ${site.profile.name}`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site).toString();
const ogImage = absoluteUrl(withBase(image), Astro.site?.toString());
const accentRgb = hexToRgbChannels(site.theme.accent);
const accentInk = darken(site.theme.accent, 0.62);
const themeMode = site.theme.mode;

const themeScript = `(function(){try{var s=localStorage.getItem("theme");var f=${JSON.stringify(themeMode)};var m=window.matchMedia("(prefers-color-scheme: light)").matches?"light":"dark";var t=s==="light"||s==="dark"?s:(f==="system"?m:f);document.documentElement.dataset.theme=t;document.documentElement.style.colorScheme=t;}catch(e){document.documentElement.dataset.theme="dark";}})();`;
const themeHash = createHash('sha256').update(themeScript, 'utf8').digest('base64');

const analytics = site.analytics;
const analyticsEndpoint =
  analytics.provider === 'umami' && analytics.endpoint ? analytics.endpoint.replace(/\/$/, '') : '';
const analyticsOrigin = analyticsEndpoint ? new URL(analyticsEndpoint).origin : '';
const analyticsEnabled =
  analytics.provider !== 'none' &&
  Boolean(analytics.siteId) &&
  (analytics.provider === 'goatcounter' || Boolean(analyticsOrigin));
const goatcounterHost =
  analytics.provider === 'goatcounter' && analytics.siteId ? `https://${analytics.siteId}.goatcounter.com` : '';
const adminVariant = !chrome;

const csp = [
  "default-src 'self'",
  `script-src 'self' 'sha256-${themeHash}'${analytics.provider === 'goatcounter' ? ' https://gc.zgo.at' : ''}${analyticsOrigin ? ` ${analyticsOrigin}` : ''}`,
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob: https:",
  "font-src 'self'",
  `connect-src 'self'${goatcounterHost ? ` ${goatcounterHost}` : ''}${analyticsOrigin ? ` ${analyticsOrigin}` : ''}${adminVariant ? ' https://api.github.com' : ''}`,
  "frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com",
  "media-src 'self' https:",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self' https://api.web3forms.com https://formspree.io",
  "manifest-src 'self'",
  "worker-src 'self' blob:",
].join('; ');

const graph = [
  {
    '@type': 'WebSite',
    '@id': `${Astro.site?.toString() ?? ''}#website`,
    url: Astro.site?.toString(),
    name: siteName,
    inLanguage: site.locale,
    publisher: { '@id': `${Astro.site?.toString() ?? ''}#person` },
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang={site.locale} data-theme={themeMode === 'light' ? 'light' : 'dark'} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!import.meta.env.DEV && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow, noarchive" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large" />
      )
    }

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${site.profile.name} — ${site.profile.title}`} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="sitemap" href={withBase('/sitemap.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.profile.name} — projects`}
      href={withBase('/rss.xml')}
    />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />

    <style is:inline set:html={`:root{--accent-rgb:${accentRgb};--accent-ink-rgb:${accentInk}}`}></style>
    <script is:inline set:html={themeScript} />

    {
      jsonLd.length > 0 && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
        />
      )
    }
    {
      analyticsEnabled && analytics.provider === 'goatcounter' && (
        <script
          is:inline
          async
          src="https://gc.zgo.at/count.js"
          data-goatcounter={`https://${analytics.siteId}.goatcounter.com/count`}
        />
      )
    }
    {
      analyticsEnabled && analytics.provider === 'umami' && analytics.endpoint && (
        <script
          is:inline
          defer
          src={`${analytics.endpoint.replace(/\/$/, '')}/script.js`}
          data-website-id={analytics.siteId}
        />
      )
    }
  </head>
  <body class="min-h-dvh">
    <a class="skip-link" href="#main">Skip to content</a>
    {chrome && <Header site={site} />}
    <main id="main" class="min-h-[60vh]">
      <slot />
    </main>
    {chrome && <Footer site={site} />}
    {chrome && <CommandPalette site={site} projects={projects} />}
    {chrome && <StickyContact site={site} />}
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
