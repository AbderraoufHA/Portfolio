{
  "name": "vanta-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static portfolio with a Git-backed admin dashboard. Astro + React island + GitHub API.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "images": "python3 scripts/generate_images.py && python3 scripts/generate_brand_assets.py",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "^4.3.0",
    "astro": "^5.13.0",
    "dompurify": "^3.2.6",
    "fflate": "^0.8.3",
    "marked": "^15.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}
