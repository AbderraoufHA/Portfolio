# Everything here is public by design — this is a static site.
# The admin dashboard asks for a GitHub token at runtime; it is never read from env.

# Public origin of the deployed site. Used for canonical URLs, OG tags, sitemap and RSS.
# User/org page:   https://<user>.github.io
# Project page:    https://<user>.github.io        (pair with BASE_PATH=/<repo>)
# Custom domain:   https://your-domain.tld
SITE_URL=https://your-username.github.io

# Path prefix for GitHub Pages project sites. Leave empty for user pages / custom domains.
# Example: BASE_PATH=/portfolio
BASE_PATH=
